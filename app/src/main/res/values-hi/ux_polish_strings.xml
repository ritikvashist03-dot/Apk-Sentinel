    <string name="ux_onboarding_language_title">अपनी भाषा चुनें</string>
    <string name="ux_onboarding_language_body">इसे बाद में गोपनीयता और सेटिंग में बदला जा सकता है। भाषाओं के नाम अपनी लिपि में रहते हैं।</string>
    <string name="ux_onboarding_language_required">जारी रखने के लिए भाषा चुनें।</string>
    <string name="ux_onboarding_progress">चरण %1$d / %2$d</string>
    <string name="ux_onboarding_accessibility_separator">।</string>
    <string name="ux_onboarding_understand_title">ऐसा सुरक्षा प्रमाण जिसे आप समझ सकें</string>
    <string name="ux_onboarding_understand_body">एक शांत डैशबोर्ड से फ़ोन, इंस्टॉल किए ऐप, APK फ़ाइल या लिंक और स्थानीय नेटवर्क गतिविधि जाँचें।</string>
    <string name="ux_onboarding_understand_detail">हम दिखाते हैं कि क्या देखा गया, उसका क्या अर्थ हो सकता है और क्या अभी अज्ञात है। APK Sentinel कभी यह वादा नहीं करता कि फ़ोन, ऐप, फ़ाइल या लिंक पूरी तरह सुरक्षित है।</string>
    <string name="ux_onboarding_private_title">डिफ़ॉल्ट रूप से स्थानीय और निजी</string>
    <string name="ux_onboarding_private_body">मुख्य जाँच इसी फ़ोन पर चलती हैं। ऑनलाइन कार्रवाई वैकल्पिक है और शुरू होने से पहले पूछती है।</string>
    <string name="ux_onboarding_private_detail">रिपोर्ट केवल आपके कहने पर बनती हैं और आपकी चुनी जगह पर सहेजी जाती हैं। ऐप का अपना डेटा गोपनीयता और सेटिंग से मिटाया जा सकता है।</string>
    <string name="ux_onboarding_honest_title">नियंत्रण आपके पास है</string>
    <string name="ux_onboarding_honest_body">स्थानीय नेटवर्क निगरानी शुरू होने से पहले Android पूछता है। आप सत्र रोक सकते हैं, सीमा देख सकते हैं या ऑफ़लाइन जाँच जारी रख सकते हैं।</string>
    <string name="ux_onboarding_honest_detail">यह परिचय पूरा करने से नियम स्वीकार नहीं होते, निगरानी शुरू नहीं होती, संवेदनशील अनुमति नहीं मिलती और डेटा साझा नहीं होता।</string>
    <string name="ux_onboarding_next">आगे बढ़ें</string>
    <string name="ux_onboarding_start">APK Sentinel खोलें</string>
    <string name="ux_onboarding_skip">परिचय छोड़ें</string>
    <string name="ux_onboarding_no_terms_consent">यह परिचय नियम, निगरानी, एनालिटिक्स या डेटा शेयरिंग की सहमति नहीं है।</string>


