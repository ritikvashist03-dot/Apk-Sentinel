    <string name="ux_onboarding_understand_title">Security evidence you can understand</string>
    <string name="ux_onboarding_understand_body">Check your phone, installed apps, APK files or links, and local network activity from one calm dashboard.</string>
    <string name="ux_onboarding_understand_detail">We show what was observed, what it may mean, and what remains unknown. APK Sentinel never promises that a phone, app, file, or link is completely safe.</string>
    <string name="ux_onboarding_private_title">Local and private by default</string>
    <string name="ux_onboarding_private_body">Core checks run on this phone. An online action is optional and asks before it starts.</string>
    <string name="ux_onboarding_private_detail">Reports are created only when you request them and saved where you choose. App-owned data can be erased from Privacy and settings.</string>
    <string name="ux_onboarding_honest_title">You stay in control</string>
    <string name="ux_onboarding_honest_body">Android asks before local network monitoring starts. You can stop a session, review a limitation, or continue with offline checks.</string>
    <string name="ux_onboarding_honest_detail">Finishing this introduction does not accept Terms, start monitoring, grant a sensitive permission, or share data.</string>
